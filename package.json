{
    "name": "@rentnerkev/menu",
    "version": "0.1.0",
    "description": "Accessible React dropdown and context menus with nested submenus, keyboard navigation and shared RentnerKev styling.",
    "author": "RentnerKev",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "tailwind.css",
        "theme.css",
        "README.md",
        "docs/usage.md"
    ],
    "sideEffects": [
        "./tailwind.css",
        "./theme.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./menu": {
            "types": "./dist/shared/Menu/Components/Menu.d.ts",
            "import": "./dist/shared/Menu/Components/Menu.js"
        },
        "./context-menu": {
            "types": "./dist/shared/Menu/Components/ContextMenu.d.ts",
            "import": "./dist/shared/Menu/Components/ContextMenu.js"
        },
        "./provider": {
            "types": "./dist/shared/Menu/Components/MenuProvider.d.ts",
            "import": "./dist/shared/Menu/Components/MenuProvider.js"
        },
        "./types": {
            "types": "./dist/shared/Menu/Types/menu.types.d.ts",
            "import": "./dist/shared/Menu/Types/menu.types.js"
        },
        "./ai": {
            "types": "./dist/ai.d.ts",
            "import": "./dist/ai.js"
        },
        "./tailwind.css": "./tailwind.css",
        "./theme.css": "./theme.css",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "bun scripts/build.ts && tsc",
        "prepare": "bun run build",
        "typecheck": "tsc --noEmit && tsc --project tsconfig.type-tests.json && bun run typecheck:playground && bun run typecheck:automation",
        "typecheck:playground": "tsc --noEmit -p playground/tsconfig.json",
        "typecheck:automation": "tsc --noEmit -p .github/scripts/tsconfig.json",
        "test": "bun test",
        "e2e": "playwright test",
        "pack:check": "bun pm pack --dry-run",
        "pack:consumer": "bun scripts/consumer/verify.ts",
        "playground:install": "bun install --cwd playground --frozen-lockfile",
        "playground:dev": "bun --cwd playground dev",
        "playground:build": "bun --cwd playground build",
        "lint": "oxlint --deny-warnings src scripts playground/src playground/vite.config.ts playwright.config.ts .github/scripts",
        "lint:fix": "oxlint --fix --deny-warnings src scripts playground/src playground/vite.config.ts playwright.config.ts .github/scripts",
        "format": "bun fmt src scripts playground .github docs README.md package.json tsconfig.json tsconfig.type-tests.json playwright.config.ts .oxlintrc.json bunfig.toml theme.css tailwind.css cliff.toml",
        "format:check": "bun fmt --check src scripts playground .github docs README.md package.json tsconfig.json tsconfig.type-tests.json playwright.config.ts .oxlintrc.json bunfig.toml theme.css tailwind.css cliff.toml",
        "verify": "bun run playground:install && bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build && bun run pack:check && bun run pack:consumer && bun run playground:build && bun run e2e"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RentnerKev/RentnerMenu.git"
    },
    "homepage": "https://github.com/RentnerKev/RentnerMenu#readme",
    "bugs": {
        "url": "https://github.com/RentnerKev/RentnerMenu/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@happy-dom/global-registrator": "^21.0.4",
        "@playwright/test": "^1.64.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/bun": "^1.4.4",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "happy-dom": "^21.0.4",
        "oxlint": "^1.90.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "typescript": "^7.0.2"
    },
    "packageManager": "bun@1.4.4"
}
